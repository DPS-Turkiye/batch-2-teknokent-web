APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
BACKEND_USERNAME=teknokent
BACKEND_PASSWORD=change-me
SESSION_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080/ws
# Browser-visible backend URL for document uploads, which go straight to the
# backend instead of through this app's own proxy (see DOCUMENTS_ALLOWED_ORIGINS
# on the backend). Must match BACKEND_URL's host in prod, just NEXT_PUBLIC_.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Firebase web app config: Firebase Console -> Project settings -> General ->
# Your apps -> Web app. These are public by design; the private service-account
# key stays in the backend only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
