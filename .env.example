APP_URL=http://localhost:3000
# Document uploads go straight from the browser to this host, bypassing this
# app's proxy routes (see DOCUMENTS_ALLOWED_ORIGINS on the backend). amplify.yml
# derives NEXT_PUBLIC_BACKEND_URL from this value, so the two cannot drift; if
# you point this at a non-local backend, set NEXT_PUBLIC_BACKEND_URL to match.
BACKEND_URL=http://localhost:8080
BACKEND_USERNAME=teknokent
BACKEND_PASSWORD=change-me
SESSION_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080/ws
# ODTÜ sign-in, local development only: "true" shows "ODTÜ Hesabıyla Giriş Yap" and the test persona page
# /login/odtu/dev. Needs the backend's INSTITUTION_LOGIN_DEV_STUB=true. Never set it on a deployed site.
NEXT_PUBLIC_ODTU_DEV_LOGIN=false
# "OTG ile giriş yap" (ODTÜ TEKNOKENT Girişimcilik): "true" shows the button and opens /auth/otg/start and
# /auth/otg/callback. Only on a deployment whose callback URL OTG has registered, with the backend's
# OTG_LOGIN_ENABLED=true. Locally that is http://localhost:3000/auth/otg/callback.
NEXT_PUBLIC_OTG_LOGIN_ENABLED=false

# Firebase web app config: Firebase Console -> Project settings -> General ->
# Your apps -> Web app. These are public by design; the private service-account
# key stays in the backend only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Shows the Türkçe/English switch and lets the browser language pick English. Keep it off in
# production until the main screens are translated.
NEXT_PUBLIC_ENABLE_ENGLISH=false

# Which deployment this is: TEKNOKENT (default; startup mentoring) or ODTU (office hours + İŞKUR: the
# /student, /academician, /office-hours, /lti and ODTÜ login pages). Each edition answers 404 for the
# other one's pages. Must match the backend's APP_EDITION.
APP_EDITION=TEKNOKENT
