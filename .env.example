APP_URL=http://localhost:3000
# Document uploads go straight from the browser to this host, bypassing this
# app's proxy routes (see DOCUMENTS_ALLOWED_ORIGINS on the backend). amplify.yml
# derives NEXT_PUBLIC_BACKEND_URL from this value, so the two cannot drift; if
# you point this at a non-local backend, set NEXT_PUBLIC_BACKEND_URL to match.
BACKEND_URL=http://localhost:8080
BACKEND_USERNAME=teknokent
BACKEND_PASSWORD=change-me
SESSION_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080/ws

# Firebase web app config: Firebase Console -> Project settings -> General ->
# Your apps -> Web app. These are public by design; the private service-account
# key stays in the backend only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
